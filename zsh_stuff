bindkey -v
export KEYTIMEOUT=1

dotfiles_source="${(%):-%x}"
dotfiles_dir="${dotfiles_source:A:h}"

if [[ -x /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
    eval "$(/usr/local/bin/brew shellenv)"
fi

path=("$HOME/.local/bin" "$dotfiles_dir/scripts" $path)
typeset -U path
export PATH
# Existing prompts read the current selection without restarting their shell.
function dotfiles_theme_refresh() {
    local theme_generated="${XDG_CONFIG_HOME:-$HOME/.config}/terminal-theme/generated"
    if [[ -r "$theme_generated/shell.zsh" ]]; then
        source "$theme_generated/shell.zsh"
        if [[ "${XDG_CONFIG_HOME:-$HOME/.config}/starship.toml" -nt "$theme_generated/starship.toml" ]]; then
            command theme refresh-shell
        fi
    else
        export BAT_THEME="gruvbox-dark"
        [[ "${STARSHIP_CONFIG:-}" == "$theme_generated/starship.toml" ]] && unset STARSHIP_CONFIG
        [[ "${ATUIN_THEME_DIR:-}" == "$theme_generated/atuin" ]] && unset ATUIN_THEME_DIR
    fi
    return 0
}
autoload -Uz add-zsh-hook
add-zsh-hook -d precmd dotfiles_theme_refresh
add-zsh-hook precmd dotfiles_theme_refresh
add-zsh-hook -d preexec dotfiles_theme_refresh
add-zsh-hook preexec dotfiles_theme_refresh
dotfiles_theme_refresh
if [[ " ${FZF_DEFAULT_OPTS:-} " != *" --color=base16 "* ]]; then
    export FZF_DEFAULT_OPTS="${FZF_DEFAULT_OPTS:+$FZF_DEFAULT_OPTS }--color=base16"
fi
alias ls='eza --icons=always -x --sort=extension'
alias lg='lazygit'
alias cc='claude'
alias rr='remote_run --skip-flush'
alias rfr='remote_run'
alias reload='exec zsh'

if command -v starship >/dev/null 2>&1; then
    eval "$(starship init zsh)"
fi

if command -v zoxide >/dev/null 2>&1; then
    eval "$(zoxide init zsh)"
fi

if command -v atuin >/dev/null 2>&1; then
    eval "$(atuin init zsh)"
fi

[[ "$TERM_PROGRAM" == "kiro" ]] && . "$(kiro --locate-shell-integration-path zsh)"
