#!/usr/bin/env bash
set -euo pipefail

DOTFILES_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

export DOTFILES_PROMPT_OPTIONAL_TOOLS="${DOTFILES_PROMPT_OPTIONAL_TOOLS:-0}"
export DOTFILES_INSTALL_CODEX="${DOTFILES_INSTALL_CODEX:-1}"
export DOTFILES_INSTALL_CLAUDE="${DOTFILES_INSTALL_CLAUDE:-1}"
export DOTFILES_INSTALL_SPOTIFY_PLAYER="${DOTFILES_INSTALL_SPOTIFY_PLAYER:-1}"

exec "$DOTFILES_DIR/install.sh" "$@"
