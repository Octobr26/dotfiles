#!/usr/bin/env python3
"""Replay deterministic private harness experiments; report everything else as non-automated.

Runs top-level unittest files and replay.json manifests only. Never called by harness-check,
default tests or hooks. Prints to stdout; writes no report files. A pass shows regression
coverage, not better real-world outcomes.
"""
import argparse
import json
from pathlib import Path
import runpy
import subprocess
import sys
import tempfile
import unittest

CASE_TIMEOUT_SECONDS = 300
READINESS_KEYS = {'version', 'task', 'mode', 'actor'}
MODEL_RUN_KEYS = {'total_cost_usd', 'modelUsage', 'duration_api_ms'}


def json_keys(path):
    try:
        value = json.loads(path.read_text())
    except (OSError, ValueError, UnicodeDecodeError):
        return set()
    return set(value) if isinstance(value, dict) else set()


def run(argv, cwd):
    try:
        return subprocess.run(argv, cwd=cwd, capture_output=True, text=True, timeout=CASE_TIMEOUT_SECONDS).returncode
    except (OSError, subprocess.TimeoutExpired):
        return None


def unittest_child(path, output):
    """Observe standard unittest results without replacing the script's entry point."""
    results, successes = [], {}
    original_run = unittest.TextTestRunner.run
    original_success = unittest.TestResult.addSuccess

    def record_success(result, test):
        successes[id(result)] = successes.get(id(result), 0) + 1
        return original_success(result, test)

    def record_run(runner, test):
        result = original_run(runner, test)
        results.append({'tests': result.testsRun, 'skipped': len(result.skipped),
                        'passed': successes.pop(id(result), 0), 'successful': result.wasSuccessful()})
        return result

    unittest.TestResult.addSuccess = record_success
    unittest.TextTestRunner.run = record_run
    sys.argv = [str(path)]
    try:
        runpy.run_path(str(path), run_name='__main__')
    finally:
        output.write_text(json.dumps(results))


def replay_unittest(path, cwd):
    with tempfile.TemporaryDirectory(prefix='replay-unittest-') as scratch:
        output = Path(scratch) / 'results.json'
        code = run([sys.executable, '-I', str(Path(__file__).resolve()),
                    '--unittest-child', str(path), '--unittest-result', str(output)], cwd)
        if code != 0:
            return 'failed', f'exit {code}'
        try:
            results = json.loads(output.read_text())
        except (OSError, ValueError):
            return 'manual', 'no observed unittest results'
    if not results:
        return 'manual', 'no observed unittest results'
    tests = sum(result['tests'] for result in results)
    passed = sum(result['passed'] for result in results)
    skipped = sum(result['skipped'] for result in results)
    detail = f'{tests} reported, {passed} passed, {skipped} skipped'
    if not all(result['successful'] for result in results):
        return 'failed', detail
    if not passed:
        return 'manual', detail + '; no passing tests'
    return 'passed', detail


def manifest_cases(directory, manifest):
    try:
        cases = json.loads(manifest.read_text())['cases']
    except (OSError, ValueError, KeyError, TypeError):
        return [], [(directory.name, 'replay.json is unreadable or has no cases list')]
    results, skipped = [], []
    for case in cases:
        name = directory.name + '/' + str(case.get('id', '?')) if isinstance(case, dict) else directory.name + '/?'
        argv = case.get('argv') if isinstance(case, dict) else None
        expected = case.get('expected_exit') if isinstance(case, dict) else None
        if not (isinstance(argv, list) and argv and all(isinstance(x, str) for x in argv)) or not isinstance(expected, int):
            skipped.append((name, 'case needs argv list and integer expected_exit'))
            continue
        actual = run(argv, directory)
        results.append((name, actual == expected, f'exit {actual}, expected {expected}'))
    return results, skipped


def classify(directory):
    files = [path for path in directory.rglob('*') if path.is_file()]
    keys = [json_keys(path) for path in files if path.suffix == '.json']
    if any(READINESS_KEYS <= found for found in keys):
        return 'readiness record bound to a historical repository state'
    if any(MODEL_RUN_KEYS & found for found in keys):
        return 'model-dependent evaluation'
    return 'no executable expectation (prose or unclassified)'


def replay(experiments):
    passed, failed, manual = [], [], []
    for entry in sorted(experiments.iterdir()):
        if entry.is_file() and entry.suffix == '.py':
            if 'unittest' not in entry.read_text(errors='replace'):
                manual.append((entry.name, 'script without unittest assertions'))
                continue
            status, detail = replay_unittest(entry.resolve(), experiments)
            {'passed': passed, 'failed': failed, 'manual': manual}[status].append((entry.name, detail))
        elif entry.is_dir() and (entry / 'replay.json').is_file():
            results, skipped = manifest_cases(entry, entry / 'replay.json')
            for name, ok, detail in results:
                (passed if ok else failed).append((name, detail))
            manual.extend(skipped)
        elif entry.is_dir():
            manual.append((entry.name, classify(entry)))
        elif entry.is_file():
            manual.append((entry.name, 'prose or data file, not executable'))
    return passed, failed, manual


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument('--experiments', type=Path,
                        default=Path.home() / '.local/state/agent-workflow/experiments')
    parser.add_argument('--unittest-child', type=Path, help=argparse.SUPPRESS)
    parser.add_argument('--unittest-result', type=Path, help=argparse.SUPPRESS)
    args = parser.parse_args()
    if args.unittest_child is not None:
        if args.unittest_result is None:
            parser.error('--unittest-child requires --unittest-result')
        unittest_child(args.unittest_child, args.unittest_result)
        return 0
    if not args.experiments.is_dir():
        sys.exit(f'Experiments directory not found: {args.experiments}')
    passed, failed, manual = replay(args.experiments)
    for title, rows in (('Passed', passed), ('Failed', failed), ('Non-automated', manual)):
        print(f'## {title}')
        print('\n'.join(f'- {name}: {detail}' for name, detail in rows) or '- none')
        print()
    print(f'passed {len(passed)}, failed {len(failed)}, non-automated {len(manual)}')
    print('Non-automated cases are neither passes nor failures. A pass is regression coverage, not proof of better outcomes.')
    return 1 if failed else 0


if __name__ == '__main__':
    sys.exit(main())
