#!/usr/bin/env bash
set -euo pipefail

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# macOS can put its Python 3.9 ahead of Homebrew in a popup's PATH.
for python_bin in python3.14 python3.13 python3.12 python3.11 /opt/homebrew/bin/python3 /usr/local/bin/python3 python3; do
    if command -v "$python_bin" >/dev/null 2>&1 && "$python_bin" -c 'import tomllib' 2>/dev/null; then
        exec "$python_bin" "$script_dir/theme-selector.py" "$@"
    fi
done
printf '%s\n' 'theme requires Python 3.11 or newer.' >&2
exit 1
