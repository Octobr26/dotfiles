#!/usr/bin/env python3
"""Native hook guardrail for explicitly enrolled readiness sessions, not an OS boundary."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import shlex
import subprocess
import sys

CLI = Path(__file__).resolve().with_name('agent-readiness')
MAX_JSON_BYTES = 2 * 1024 * 1024
EDIT_TOOLS = frozenset(('Write', 'Edit', 'apply_patch'))
# Shell tools get a bounded check for known direct edit forms only; see readiness.md.
SHELL_TOOLS = frozenset(('Bash', 'exec_command'))
PATCH_FILES = re.compile(r'^\*\*\* (?:Add File|Update File|Delete File|Move to): (.+)$', re.MULTILINE)
HEREDOC = re.compile(r"<<-?[ \t]*(?P<quote>['\"]?)(?P<delimiter>[A-Za-z_][A-Za-z0-9_]*)(?P=quote)"
                     r"(?P<tail>[^\n]*)\n(?P<body>.*?)^[ \t]*(?P=delimiter)[ \t]*$",
                     re.DOTALL | re.MULTILINE)
SEPARATORS = frozenset((';', ';;', '&&', '||', '|', '|&', '&', '(', ')'))
REDIRECTS = frozenset(('>', '>>', '>|', '&>', '&>>'))
UNRESOLVABLE = re.compile(r'[$`*?\[\]{}~]')


def read_json(path):
    if path.is_symlink() or path.stat().st_size > MAX_JSON_BYTES:
        raise ValueError('Readiness record must be a bounded regular JSON file.')
    value = json.loads(path.read_text())
    if not isinstance(value, dict):
        raise ValueError('Readiness record must be a JSON object.')
    return value


def enrollment(payload, state_dir):
    targets = action_targets(payload, state_dir)
    if not targets:
        return None
    index = state_dir / 'sessions' / (hashlib.sha256(payload['session_id'].encode()).hexdigest() + '.json')
    if not index.exists():
        return None
    binding = read_json(index)
    if binding.get('version') != 1 or binding.get('actor') != payload['session_id'] or not isinstance(binding.get('records'), dict):
        raise ValueError('Readiness session index is malformed.')
    matched = []
    for repository, filename in binding['records'].items():
        if not Path(repository).is_absolute() or not isinstance(filename, str) or not Path(filename).is_absolute():
            raise ValueError('Readiness session index needs absolute repository and record paths.')
        if any(target.is_relative_to(Path(repository).resolve()) for target in targets):
            path = Path(filename)
            record = read_json(path)
            if record.get('actor') != payload['session_id'] or record.get('repository') != repository:
                raise ValueError('Readiness record does not match native session enrollment.')
            matched.append((path, record))
    if len(matched) > 1:
        raise ValueError('This tool targets multiple repositories; split it into separately enrolled operations.')
    if matched and not all(target.is_relative_to(Path(matched[0][1]['repository']).resolve()) for target in targets):
        raise ValueError('This tool targets multiple repositories; one accepted record cannot authorize all files.')
    return matched[0] if matched else None


def shell_command(arguments):
    value = arguments.get('command', arguments.get('cmd')) if isinstance(arguments, dict) else arguments
    if isinstance(value, list) and all(isinstance(part, str) for part in value):
        value = value[-1] if len(value) >= 3 and value[-2] in ('-c', '-lc') else shlex.join(value)
    return value if isinstance(value, str) else ''


def command_words(words):
    while words and re.fullmatch(r'[A-Za-z_][A-Za-z0-9_]*=.*', words[0]):
        words = words[1:]
    return words


def shell_tokens(command):
    # A newline separates commands only outside quotes; patch arguments keep theirs.
    separated, quote, escaped = [], None, False
    for char in command:
        if escaped:
            escaped = False
        elif char == '\\' and quote != "'":
            escaped = True
        elif quote:
            if char == quote:
                quote = None
        elif char in ('"', "'"):
            quote = char
        elif char == '\n':
            separated.append(' ; ')
            continue
        separated.append(char)
    lexer = shlex.shlex(''.join(separated), posix=False, punctuation_chars=True)
    lexer.whitespace_split = True
    raw = list(lexer)
    values = [''.join(shlex.split(token)) if any(quote in token for quote in '\'"') else token for token in raw]
    return raw, values


def heredoc_commands(command):
    """Keep executable headers; only an apply_patch command owns patch stdin."""
    parts, patch_files, end = [], [], 0
    for match in HEREDOC.finditer(command):
        parts.append(command[end:match.start()])
        try:
            raw, values = shell_tokens(''.join(parts))
            words, index = [], 0
            while index < len(raw):
                token, value = raw[index], values[index]
                if token == value and token in SEPARATORS:
                    words = []
                elif token == value and token in REDIRECTS | {'>&', '<&'}:
                    if words and words[-1].isdigit() and raw[index - 1] == words[-1]:
                        words.pop()
                    index += 2
                    continue
                else:
                    words.append(value)
                index += 1
            words = command_words(words)
            if len(words) == 1 and Path(words[0]).name == 'apply_patch':
                patch_files.extend(PATCH_FILES.findall(match['body']))
        except ValueError:
            pass  # Quoted or unparseable command text does not establish ownership.
        parts.append(match['tail'] + '\n')
        end = match.end()
    parts.append(command[end:])
    return ''.join(parts), patch_files


def segment_targets(words, cwd):
    """Return (targets, cwd_known) for one simple command; only the listed edit forms count."""
    words = command_words(words)
    name = Path(words[0]).name if words else ''
    arguments = words[1:]
    if name == 'cd':
        return [], False
    files = []
    if name == 'sed' and any(arg == '-i' or arg.startswith(('-i', '--in-place')) for arg in arguments):
        script_given, index = False, 0
        while index < len(arguments):
            arg = arguments[index]
            if arg == '-i' and index + 1 < len(arguments) and arguments[index + 1] == '':
                index += 1
            elif arg in ('-e', '-f'):
                script_given, index = True, index + 1
            elif not arg.startswith('-'):
                if script_given:
                    files.append(arg)
                else:
                    script_given = True
            index += 1
    elif name == 'perl':
        in_place, index = False, 0
        while index < len(arguments):
            arg = arguments[index]
            if arg.startswith('-') and not arg.startswith('--'):
                in_place = in_place or 'i' in arg[1:].split('e')[0] or arg.startswith('-i')
                if arg.endswith('e') or arg == '-e':
                    index += 1
            else:
                files.append(arg)
            index += 1
        files = files if in_place else []
    elif name == 'tee':
        files = [arg for arg in arguments if not arg.startswith('-')]
    elif name == 'apply_patch':
        files = [name for patch in arguments if patch.startswith('*** Begin Patch')
                 for name in PATCH_FILES.findall(patch)]
    return files, True


def shell_edit_paths(payload):
    """Targets of known direct shell edits; unsupported or unresolvable forms yield nothing."""
    command = shell_command(payload.get('tool_input'))
    cwd = Path(payload['cwd'])
    header_commands, patch_files = heredoc_commands(command)
    targets = [cwd / name.strip() for name in patch_files]
    try:
        # Non-POSIX lexing keeps quotes, so a quoted '>' or ';' is never an operator.
        raw, values = shell_tokens(header_commands)
    except ValueError:
        return [path.resolve() for path in targets]
    operator = lambda position: raw[position] == values[position] and raw[position]
    names, cwd_known, words, in_test, index = [], True, [], False, 0
    while index <= len(raw):
        token = operator(index) if index < len(raw) else ';'
        if token == '[[':
            in_test = True
        elif token == ']]':
            in_test = False
        if not in_test and token in REDIRECTS and index + 1 < len(raw):
            names.append((values[index + 1], cwd_known))
            index += 2
            continue
        if not in_test and token in SEPARATORS:
            found, still_known = segment_targets(words, cwd)
            names.extend((name, cwd_known) for name in found)
            cwd_known, words = cwd_known and still_known, []
        elif not in_test and token not in ('<', '<<', '<<<', '>&', '<&', ']]'):
            words.append(values[index])
        index += 1
    for name, known in names:
        if not name or name.startswith('/dev/') or UNRESOLVABLE.search(name):
            continue
        path = Path(name)
        if path.is_absolute() or known:
            targets.append(path if path.is_absolute() else cwd / path)
    return [path.resolve() for path in targets]


def edit_paths(payload):
    arguments = payload.get('tool_input', {})
    cwd = Path(payload['cwd'])
    if payload.get('tool_name') in SHELL_TOOLS:
        return shell_edit_paths(payload)
    if payload.get('tool_name') == 'apply_patch':
        patch = arguments if isinstance(arguments, str) else arguments.get('command', '') if isinstance(arguments, dict) else ''
        if not isinstance(patch, str):
            return []
        filenames = re.findall(r'^\*\*\* (?:Add File|Update File|Delete File|Move to): (.+)$', patch, re.MULTILINE)
        return [(cwd / filename).resolve() for filename in filenames]
    if isinstance(arguments, dict):
        filename = arguments.get('file_path')
        if payload.get('tool_name') in ('Write', 'Edit') and isinstance(filename, str):
            return [(cwd / filename).resolve()]
    return []


def action_targets(payload, state_dir):
    paths = edit_paths(payload) if payload['hook_event_name'] == 'PreToolUse' else []
    if paths:
        private_roots = (state_dir.resolve(), (state_dir.parent / 'experiments').resolve())
        return [path for path in paths if not any(path.is_relative_to(root) for root in private_roots)]
    return [Path(payload['cwd']).resolve()]


def repository_for(target):
    """Locate the actual checkout, including worktrees with a .git file."""
    for candidate in (target, *target.parents):
        if (candidate / '.git').exists():
            return candidate
    return None


def verify(path, phase):
    result = subprocess.run([sys.executable, str(CLI), 'check', '--record', str(path), '--phase', phase],
                            text=True, capture_output=True, timeout=25, shell=False)
    return result.returncode == 0, (result.stdout + result.stderr)[-3000:]


def deny(reason):
    print('Readiness gate: ' + reason, file=sys.stderr)
    return 2


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--state-dir', type=Path,
                        default=Path(os.environ.get('AGENT_READINESS_STATE_DIR',
                                                   Path.home() / '.local/state/agent-workflow/readiness')))
    parser.add_argument('--require-for', type=Path, action='append', default=[])
    args = parser.parse_args()
    raw = sys.stdin.read(MAX_JSON_BYTES + 1)
    if len(raw) > MAX_JSON_BYTES:
        raise ValueError('Native hook input is too large.')
    payload = json.loads(raw)
    if not isinstance(payload, dict):
        raise ValueError('Native hook input must be an object.')
    for key in ('session_id', 'cwd', 'hook_event_name'):
        if not isinstance(payload.get(key), str) or not payload[key]:
            raise ValueError('Native hook input needs ' + key + '.')
    if not Path(payload['cwd']).is_absolute():
        raise ValueError('Native hook cwd must be absolute.')
    event = payload['hook_event_name']
    if event not in ('PreToolUse', 'Stop'):
        raise ValueError('Unsupported native hook event: ' + event)
    if event == 'PreToolUse' and (not isinstance(payload.get('tool_name'), str) or 'tool_input' not in payload):
        raise ValueError('PreToolUse needs tool_name and tool_input.')
    # Explicit file edits and known direct shell edits carry a mutation target.
    # Other shell commands, MCP, clarification and coordination retain the
    # provider's normal permissions; a stale record must not block evidence.
    shell = event == 'PreToolUse' and payload['tool_name'] in SHELL_TOOLS
    if event == 'PreToolUse' and not shell and payload['tool_name'] not in EDIT_TOOLS:
        return 0
    if shell:
        try:
            if not shell_edit_paths(payload):
                return 0
        except (OSError, ValueError, TypeError, RuntimeError):
            return 0  # The shell check is best effort; it never fails closed.
    try:
        enrolled = enrollment(payload, args.state_dir)
    except (OSError, ValueError, KeyError, TypeError) as error:
        if shell:
            return 0
        if event != 'Stop':
            raise
        print(json.dumps({'systemMessage': 'Readiness could not be checked; no acceptance is implied. ' + str(error)}))
        return 0
    if not enrolled:
        if event == 'Stop':
            return 0
        targets = action_targets(payload, args.state_dir)
        required = [root.resolve() for root in args.require_for
                    if any(target.is_relative_to(root.resolve()) for target in targets)]
        if required:
            location = repository_for(targets[0])
            if location is None:
                return deny('file edit is inside a protected root but no Git repository was found for '
                            + str(targets[0]) + '. Select the actual task repository before editing.')
            command = shlex.join([str(CLI), 'init', '--repo', str(location), '--base', 'HEAD',
                                  '--mode', 'implementation', '--actor', payload['session_id'], '--task', 'Describe the task'])
            return deny('repository file edit requires enrollment and an accepted plan. Start with: ' + command)
        return 0
    path, record = enrolled
    if event == 'PreToolUse':
        if record.get('mode') == 'review' and payload['tool_name'] in EDIT_TOOLS | SHELL_TOOLS:
            return deny('a review record does not authorize repository file edits; enroll an implementation task.')
        try:
            passed, diagnostic = verify(path, 'implementation')
        except (OSError, subprocess.SubprocessError):
            if shell:
                return 0
            raise
        return 0 if passed else deny('accepted plan required before this tool. ' + diagnostic)
    # Ending a response is not a readiness claim: investigations and questions
    # must be able to finish. Explicit final checks still decide readiness.
    try:
        passed, diagnostic = verify(path, 'final')
    except (OSError, subprocess.SubprocessError) as error:
        passed, diagnostic = False, str(error)
    if not passed:
        print(json.dumps({'systemMessage': 'Readiness remains incomplete; no acceptance is implied. ' + diagnostic}))
    return 0



if __name__ == '__main__':
    try:
        sys.exit(main())
    except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError) as error:
        sys.exit(deny(str(error)))
