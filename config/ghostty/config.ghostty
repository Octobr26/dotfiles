theme = Gruvbox Dark
# Shared selector output; the theme above remains the fallback.
config-file = ?~/.config/terminal-theme/generated/ghostty.conf
font-size = 19
adjust-cell-height = 10%
background-opacity = 1.0
background-blur = 20
mouse-hide-while-typing = true
window-decoration = auto
macos-option-as-alt = true
font-family = "JetBrainsMono Nerd Font"
font-thicken = true
font-feature = +calt
window-padding-x = 12
window-padding-y = 10
